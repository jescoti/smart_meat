# Copy this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore
#
# All variables listed here are required unless marked OPTIONAL.
# ---------------------------------------------------------------

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://smart_meat:smart_meat_dev@localhost:5432/smart_meat

# ── Cache & Queue Broker ──────────────────────────────────────
# Redis connection string (used by Celery and for session caching)
REDIS_URL=redis://localhost:6379/0

# ── Auth Secrets ──────────────────────────────────────────────
# IMPORTANT: generate a strong random value for each environment.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# 32-byte AES key used to encrypt sensitive fields at rest.
# Must be exactly 32 bytes of high-entropy random data.
#   python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# ── Google OAuth ──────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OPTIONAL — defaults to http://localhost:8000/api/auth/callback
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── AI (Anthropic) ────────────────────────────────────────────
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace-with-your-api-key

# OPTIONAL — defaults to claude-sonnet-4-5-20250514
# CLAUDE_MODEL=claude-sonnet-4-5-20250514

# ── CORS ──────────────────────────────────────────────────────
# OPTIONAL — JSON array of allowed origins.
# Defaults to ["http://localhost:3000"] in development.
# CORS_ORIGINS=["http://localhost:3000"]

# ── JWT Token Lifetimes ───────────────────────────────────────
# OPTIONAL — defaults shown below.
# JWT_ACCESS_TOKEN_TTL_MINUTES=15
# JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Frontend ──────────────────────────────────────────────────
# Base URL of the backend API — consumed by the Next.js frontend.
# Must be publicly accessible (not docker-internal) when accessed from browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
